{
  "product": "Vibe Coding Store",
  "principle": "Unify data shape first. UI, API, and TypeScript types are projections of this model.",
  "entities": {
    "Creator": {
      "id": "creator",
      "fields": {
        "id": "string",
        "name": "string",
        "tagline": "string",
        "bio": "string[]",
        "wechat": "string",
        "email": "string?"
      },
      "notes": "WeChat currently duplicated on every Product. Keep it on Creator (and optionally Offer.fulfillment)."
    },
    "Product": {
      "id": "product",
      "fields": {
        "id": "string",
        "slug": "string",
        "name": "string",
        "tagline": "string",
        "longDescription": "string",
        "coverImage": "string",
        "status": "draft | live | archived"
      },
      "notes": "What is sold. No price, WeChat, or changelog text here."
    },
    "Offer": {
      "id": "offer",
      "fields": {
        "id": "string",
        "productId": "string",
        "priceAmount": "number",
        "currency": "CNY",
        "badge": "string?",
        "fulfillment": "wechat | email | download_url",
        "license": "personal_and_commercial_no_redistribution"
      },
      "notes": "Price is money, not '¥49' string. One Product can have multiple Offers later (bundle, upgrade)."
    },
    "Audience": {
      "id": "audience",
      "fields": {
        "id": "string",
        "label": "string"
      }
    },
    "Scenario": {
      "id": "scenario",
      "fields": {
        "id": "string",
        "label": "string",
        "moment": "friday_night | building | stuck | sunday_ship"
      }
    },
    "Deliverable": {
      "id": "deliverable",
      "fields": {
        "id": "string",
        "productId": "string",
        "label": "string",
        "kind": "file | template | access"
      }
    },
    "GettingStartedStep": {
      "id": "getting_started_step",
      "fields": {
        "id": "string",
        "productId": "string",
        "order": "number",
        "instruction": "string"
      }
    },
    "Tool": {
      "id": "tool",
      "fields": {
        "id": "string",
        "name": "string"
      }
    },
    "Release": {
      "id": "release",
      "fields": {
        "id": "string",
        "productId": "string?",
        "publishedAt": "date",
        "scope": "site | product | copy | positioning",
        "title": "string",
        "body": "string",
        "requiresRedownload": "boolean"
      },
      "notes": "Changelog currently hardcoded. Attach to Product when possible; site-wide entries have null productId."
    },
    "FaqItem": {
      "id": "faq_item",
      "fields": {
        "id": "string",
        "question": "string",
        "answer": "string",
        "topic": "purchase | delivery | refund | updates | audience | license"
      }
    },
    "WorkflowStep": {
      "id": "workflow_step",
      "fields": {
        "id": "string",
        "order": "number",
        "title": "string",
        "body": "string",
        "relatedProductId": "string?"
      }
    },
    "Order": {
      "id": "order",
      "fields": {
        "id": "string",
        "offerId": "string",
        "channel": "wechat",
        "status": "inquiry | paid | fulfilled | refunded",
        "buyerWechat": "string?",
        "buyerEmail": "string?",
        "fulfilledAt": "datetime?"
      },
      "notes": "Not in the app today. Needed before a real checkout page, or the buy CTA stays as WeChat inquiry."
    }
  },
  "relationships": [
    "Creator 1—* Product",
    "Product 1—* Offer",
    "Product *—* Audience",
    "Product *—* Scenario",
    "Product 1—* Deliverable",
    "Product 1—* GettingStartedStep",
    "Product *—* Tool",
    "Product 1—* Release (optional)",
    "Product 1—* WorkflowStep (optional)",
    "Offer 1—* Order"
  ],
  "contradictionsNow": [
    "price is a display string, so sorting, bundles, and currency are blocked",
    "wechat is copied onto every product; changing the handle requires editing all rows",
    "FAQ, updates, about, and workflow live only in App.tsx, so other pages cannot reuse them",
    "buyUrl is empty while FAQ describes WeChat purchase — Offer.fulfillment should be wechat",
    "no Order entity, so a checkout or 'order status' page would invent a second data model"
  ],
  "pagesFromModel": [
    {
      "page": "Home",
      "route": "/",
      "reads": ["Creator", "Product", "Offer", "Scenario", "WorkflowStep"],
      "job": "Explain who it is for, list live products with price from Offer, jump to workflow."
    },
    {
      "page": "Catalog",
      "route": "/products",
      "reads": ["Product", "Offer", "Audience"],
      "job": "Filterable list. Same Product cards as Home; not a second product shape."
    },
    {
      "page": "Product detail",
      "route": "/product/:slug",
      "reads": ["Product", "Offer", "Audience", "Scenario", "Deliverable", "GettingStartedStep", "Tool", "Release"],
      "job": "One product truth: copy, price, contents, how to start, recent releases."
    },
    {
      "page": "Purchase",
      "route": "/product/:slug/buy",
      "reads": ["Product", "Offer", "Creator"],
      "writes": ["Order"],
      "job": "WeChat inquiry with product name prefilled. Do not invent a card form until Order + payment exist."
    },
    {
      "page": "About",
      "route": "/about",
      "reads": ["Creator"],
      "job": "Creator bio only. Not a dumping ground for product features."
    },
    {
      "page": "Updates",
      "route": "/updates",
      "reads": ["Release", "Product"],
      "job": "Timeline grouped by date; product-scoped vs site-wide."
    },
    {
      "page": "FAQ",
      "route": "/faq",
      "reads": ["FaqItem"],
      "job": "Grouped by topic. Purchase answers must match Offer.fulfillment."
    },
    {
      "page": "Workflow",
      "route": "/workflow",
      "reads": ["WorkflowStep", "Product"],
      "job": "Weekend playbook. Each step may point at one Product."
    }
  ]
}
